{
  "version": "v1",
  "title": "Fictional motor claims triage, policy v1",
  "note": "Transcribed from the participant policy v1. Rules are applied in order. A known reason for human review takes priority over a missing document.",
  "rules": [
    {
      "id": "R1.policy_inactive",
      "outcome": "human_review",
      "reason": "The policy was not active on the incident date.",
      "when": [{"field": "policy_active_on_incident", "op": "is_false"}]
    },
    {
      "id": "R1.claim_type",
      "outcome": "human_review",
      "reason": "The claim type is not motor_own_damage.",
      "when": [{"field": "claim_type", "op": "neq", "value": "motor_own_damage"}]
    },
    {
      "id": "R1.injury",
      "outcome": "human_review",
      "reason": "An injury was reported.",
      "when": [{"field": "injury_reported", "op": "is_true"}]
    },
    {
      "id": "R1.liability_disputed",
      "outcome": "human_review",
      "reason": "Liability is disputed.",
      "when": [{"field": "liability_disputed", "op": "is_true"}]
    },
    {
      "id": "R1.duplicate",
      "outcome": "human_review",
      "reason": "The claim is flagged as a duplicate.",
      "when": [{"field": "duplicate_flag", "op": "is_true"}]
    },
    {
      "id": "R1.evidence_conflict",
      "outcome": "human_review",
      "reason": "The evidence contains a conflict.",
      "when": [{"field": "evidence_conflict", "op": "is_true"}]
    },
    {
      "id": "R1.quote_over_limit",
      "outcome": "human_review",
      "reason": "The repair quote is above the routine limit of EUR 1,500.",
      "when": [{"field": "quote_eur", "op": "gt", "value": 1500}]
    },
    {
      "id": "R2.incident_report_missing",
      "outcome": "request_information",
      "reason": "The incident report is missing.",
      "when": [{"field": "incident_report_present", "op": "is_false"}],
      "blank_counts_as_match": true
    },
    {
      "id": "R2.itemized_quote_missing",
      "outcome": "request_information",
      "reason": "The itemized quote is missing.",
      "when": [{"field": "itemized_quote_present", "op": "is_false"}],
      "blank_counts_as_match": true
    }
  ],
  "default": {
    "id": "R3.routine",
    "outcome": "routine_processing",
    "reason": "No rule for review or for missing information applies. The claim may enter normal downstream processing. This is not a payment approval."
  }
}
